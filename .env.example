# Copy to .env and fill with REAL values there. Never commit .env (it's gitignored).
# This file must contain ONLY placeholders — no real keys, ever.
PORT=3000

# Firebase: console.firebase.google.com → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON on ONE line as the value in .env (not here).
FIREBASE_SERVICE_ACCOUNT_KEY=PASTE_SERVICE_ACCOUNT_JSON_ON_ONE_LINE_HERE

# GitHub: Settings → Developer settings → Personal access tokens (classic), scopes: repo + workflow.
GITHUB_TOKEN=PASTE_GITHUB_TOKEN_HERE
GITHUB_OWNER=
GITHUB_REPO=blenderlab
GITHUB_WORKFLOW=blender-runner.yml

# Cloudflare R2: dash.cloudflare.com → Storage & databases → R2 → Overview → Manage (API Tokens).
R2_BUCKET_NAME=
R2_ACCESS_KEY=PASTE_R2_ACCESS_KEY_ID_HERE
R2_SECRET_KEY=PASTE_R2_SECRET_ACCESS_KEY_HERE
CF_ACCOUNT_ID=PASTE_CLOUDFLARE_ACCOUNT_ID_HERE
R2_PUBLIC_URL=https://pub-REPLACE_ME.r2.dev
WINDOW_MINUTES=350
